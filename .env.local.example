# ── Neon PostgreSQL ──────────────────────────────
DATABASE_URL=

# ── Supabase Storage ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pdfs

# ── Cloudinary ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── App ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Groq AI (passage explanations) ───────────────
# Add your key here, then restart the dev server.
GROQ_API_KEY=
# Optional: override the model id (must match your Groq catalog entry).
GROQ_MODEL=qwen/qwen3.8-27b
